[Unit]
Description=AI Studio docs end-to-end crawler (resume-safe)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/data

[Service]
Type=simple
User=root
WorkingDirectory=/data/opencode/aidocs
ExecStart=/usr/bin/python3 /data/opencode/aidocs/crawl_ai.py --max-pages 8000 --concurrency 15
Restart=always
RestartSec=60
StandardOutput=append:/data/opencode/aidocs/crawl.log
StandardError=append:/data/opencode/aidocs/crawl.log

[Install]
WantedBy=multi-user.target
